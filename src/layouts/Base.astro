---
// 最小限のベースレイアウト。KaTeX の CSS を読み込む。
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
}

const { title = 'Mebae' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

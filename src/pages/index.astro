---
import Base from '../layouts/Base.astro';
import courses from '../../courses.json';
import { getChapters } from '../lib/lessons';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// courses.json を order 昇順に並べ、各科目の章一覧を添える
const sortedCourses = [...courses].sort((a, b) => a.order - b.order);
const courseChapters = await Promise.all(
  sortedCourses.map(async (course) => ({
    course,
    chapters: await getChapters(course.id),
  })),
);
---

<Base title="Mebae — 科目一覧">
  <h1>Mebae 科目一覧</h1>
  <p>学びたい科目を選んでください。</p>

  {
    courseChapters.map(({ course, chapters }) => (
      <section>
        <h2>{course.title}</h2>
        {chapters.length === 0 ? (
          <p>準備中です。</p>
        ) : (
          <ul>
            {chapters.map((chapter) => (
              <li>
                <a href={`${base}/${chapter.subject}/${chapter.chapterId}`}>
                  {chapter.title}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</Base>

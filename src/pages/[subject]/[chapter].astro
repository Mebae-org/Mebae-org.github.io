---
import LessonSection from '../../components/LessonSection.astro';
import { getChapterRootSection, getChapters } from '../../lib/lessons';

export async function getStaticPaths() {
  const chapters = await getChapters();
  return chapters.flatMap((chapter) => {
    const section = getChapterRootSection(chapter);
    return section
      ? [{
          params: { subject: chapter.subject, chapter: chapter.chapterId },
          props: { chapter, section },
        }]
      : [];
  });
}

const { chapter, section } = Astro.props;
---

<LessonSection chapter={chapter} section={section} />
